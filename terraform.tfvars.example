# Copy to terraform.tfvars and fill in your values.

# Optional: AWS region (defaults to us-west-2).
# aws_region = "us-west-2"

vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-yyyyyyyyyyyyyyyyy",
]

# Note: the server cert is created externally by the org PKI
# (./scripts/gen-pki.sh) and imported into ACM by acm.tf — no acm_cert_arn.

domain_name = "api.example.com"

# Optional: org PKI material produced by ./scripts/gen-pki.sh (defaults shown).
# mtls_ca_bundle_path = "certs/pki/ca.crt"
# server_cert_path    = "certs/pki/server.crt"
# server_key_path     = "certs/pki/server.key"
